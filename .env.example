# Copy this file to .env. npm start loads it automatically (Node 22+).
# On Windows, change PYTHON to python if python3 is unavailable.
HOST=127.0.0.1
PORT=8787
PYTHON=python3
# ESP32_URL=http://YOUR_ESP32_IP
# For LAN access, HOST=0.0.0.0 requires a long random API_TOKEN.
# API_TOKEN=YOUR_RANDOM_SECRET

# Must match DEVICE_READ_TOKEN in the ESP32 secrets.h.
# ESP32_READ_TOKEN=YOUR_DEVICE_READ_TOKEN
